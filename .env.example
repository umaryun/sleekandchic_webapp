# Copy to .env.local and fill in. Required values stop the server from starting
# in production when missing (see lib/env.ts).

# ── Required ──────────────────────────────────────────────
# Supabase Postgres (transaction pooler, port 6543)
DATABASE_URL=
# Random 32+ character string: `npx auth secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of this storefront, e.g. https://sleekandchic.com (defaults to http://localhost:3000 in development)
BETTER_AUTH_URL=

# ── Admin console ─────────────────────────────────────────
# Comma-separated origins of the admin app (defaults to http://localhost:3001 in development)
ADMIN_APP_URL=

# ── Payments ──────────────────────────────────────────────
# Paystack secret key (sk_test_... or sk_live_...). Without it, card payments are unavailable.
PAYSTACK_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────
# Order confirmations, new-order alerts to the shop, password resets, staff
# invites. Set up ONE of the two options below. Without either, emails are
# written to the server log instead of sent. The admin's Settings page has a
# "Send test email" button to check it works.
#
# Option 1, Gmail (no domain needed): turn on 2-step verification for the
# Gmail account, create an app password at https://myaccount.google.com/apppasswords
# and paste the 16 letters into SMTP_PASS. Gmail sends up to about 500 emails a day.
SMTP_HOST=
# 465 (SSL) or 587 (STARTTLS). Defaults to 465.
SMTP_PORT=
# e.g. sleekandchic5@gmail.com
SMTP_USER=
SMTP_PASS=
#
# Option 2, Resend: needs a domain you own, verified in Resend.
RESEND_API_KEY=
# The sender. Required for Resend, on the verified domain, e.g.
# Sleekandchic <orders@sleekandchic.com>. With Gmail, leave it empty.
EMAIL_FROM=
# Receives new-order alerts when none are set in the admin's Settings page.
# Defaults to sleekandchic5@gmail.com (lib/store.ts).
OWNER_NOTIFICATION_EMAIL=

# ── Image uploads (Supabase Storage) ──────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Request limits (optional) ─────────────────────────────
# Upstash Redis for checkout/tracking/contact limits. Without these, the limits
# are counted in the rate_limits table in Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Migrations only (drizzle-kit) ─────────────────────────
# Direct connection (port 5432); optional, derived from DATABASE_URL when unset
DATABASE_URL_DIRECT=

# ── Development only (optional) ───────────────────────────
# Devices allowed to open the dev server, e.g. your phone on the same Wi-Fi
DEV_ORIGINS=
